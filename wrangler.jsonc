{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dailypokerbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "durable_objects": {
    "bindings": [{ "name": "TABLE", "class_name": "TableDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableDO"] }],
  "env": {
    "dev": {
      "name": "dailypokerbot-dev",
      "durable_objects": {
        "bindings": [{ "name": "TABLE", "class_name": "TableDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableDO"] }],
      "vars": {
        "ALLOWED_CHAT_IDS": "-1003385011529",
        "OWNER_USER_ID": "6757766821",
        "BOT_USERNAME": "daily_poker_bot",
        "WEBHOOK_PATH": "cb466b8f84dae489f4e2356008b598a0"
      }
    },
    // Production does not exist yet: set the real values here before the first deploy.
    "production": {
      "name": "dailypokerbot",
      "durable_objects": {
        "bindings": [{ "name": "TABLE", "class_name": "TableDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TableDO"] }],
      "vars": {
        "ALLOWED_CHAT_IDS": "-1000000000000",
        "OWNER_USER_ID": "123456789",
        "BOT_USERNAME": "dailypoker_bot",
        "WEBHOOK_PATH": "replace-with-random-hex"
      }
    }
  }
}
